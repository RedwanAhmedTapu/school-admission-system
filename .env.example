# Copy to .env to override defaults. Every value has a working default, so this file is optional.

# PostgreSQL
POSTGRES_DB=school_admission
POSTGRES_USER=school
POSTGRES_PASSWORD=school_pw

# Backend connection string (must match the values above)
DB_CONNECTION=Host=db;Port=5432;Database=school_admission;Username=school;Password=school_pw

# Seat hold length in seconds (assignment default: 600)
HOLD_DURATION_SECONDS=600

# How often the background worker releases expired holds
EXPIRY_SWEEP_INTERVAL_SECONDS=5

# Insert demo classes when the database is empty
SEED_DEMO_DATA=true

# Backend URL as seen from the browser (used by the frontend container)
API_URL=http://localhost:8080
